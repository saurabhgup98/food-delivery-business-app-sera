# Simple Environment Configuration

# Authentication API (always goes to deployed auth service)
VITE_AUTH_API_URL=https://simple-authentication-service.vercel.app

# Backend API (local vs deployed)
# For local development:
VITE_BACKEND_API_URL=http://localhost:5001
# For production, uncomment the line below and comment the line above:
# VITE_BACKEND_API_URL=https://food-delivery-backend-sera.vercel.app

# Environment
NODE_ENV=development
